{
  "name": "spotify",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "cf build && node scripts/stage-web-assets.mjs",
    "typecheck": "node node_modules/@typescript/native/bin/tsc --noEmit",
    "test": "bun test",
    "check": "bun run lint && bun run lint:unused && bun run typecheck && bun test && bun run build",
    "dev": "bash scripts/dev.sh",
    "dev:web": "vite dev",
    "desktop:dev": "cargo run --manifest-path desktop/Cargo.toml",
    "desktop:check": "cargo test --manifest-path desktop/Cargo.toml --locked",
    "desktop:build": "bash scripts/build-desktop.sh",
    "start": "vite preview",
    "lint": "eslint .",
    "preview": "vite preview",
    "local:music": "PORT=5176 bun run src/server/local-music-server.ts",
    "mini:deploy": "bash scripts/deploy-mini.sh",
    "mini:install-caddy": "bash scripts/install-mini-caddy.sh",
    "mini:install-dns-watch": "bash scripts/install-mini-dns-watch.sh",
    "mini:install-server": "bash scripts/install-mini-server.sh",
    "mini:install-yt-dlp": "bash scripts/install-mini-yt-dlp.sh",
    "mini:sync-music": "bash scripts/sync-mini-music.sh",
    "mini:check": "bash scripts/check-mini.sh",
    "db:migrate:local": "wrangler d1 migrations apply spotify-db --local",
    "db:migrate:remote": "CLOUDFLARE_ACCOUNT_ID=9349e7e9527ec0aad29368255a686ec4 node node_modules/cf/bin/cf d1 migrations apply 88a7aea6-ab87-43e9-a728-bca750986ccc --dir db/d1-migrations",
    "deploy": "cf deploy",
    "upload": "cf deploy --dry-run",
    "download:liked": "bun scripts/download-liked-to-music.ts",
    "icons": "bun scripts/generate-icons.ts",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "lint:unused": "knip",
    "deploy:dry-run": "cf deploy --dry-run"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "hls.js": "^1.6.16",
    "hono": "^4.12.28",
    "lucide-react": "^0.575.0",
    "music-metadata": "11.12.3",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-router": "^8.3.0",
    "sharp": "^0.35.3",
    "tailwind-merge": "^3.6.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "2.0.0-beta.sha-52b0dc0e9",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^25.9.5",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitejs/plugin-react": "^6.0.4",
    "bun-types": "^1.3.14",
    "cf": "1.0.0-beta.12",
    "eslint": "^10.8.0",
    "knip": "^6.38.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.1.5",
    "wrangler": "4.147.0"
  },
  "overrides": {
    "baseline-browser-mapping": "^2.10.0",
    "brace-expansion": "5.0.8",
    "flatted": "3.4.2",
    "postcss": "8.5.23"
  },
  "trustedDependencies": [
    "@tailwindcss/oxide",
    "sharp",
    "unrs-resolver"
  ],
  "engines": {
    "node": ">=22.18.0"
  }
}
